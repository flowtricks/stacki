# Build output and installs: generated, never hand-edited.
node_modules/
dist/
release/
coverage/
test/.stacki-test/
**/generated/

# Fixtures and corpora are byte-exact inputs to round-trip tests; formatting
# them would change what the tests measure.
test/fixtures/
test/corpus/

# Lockfiles are owned by npm.
package-lock.json

# Markdown is prose and tables; its line breaks are authored, not formatted.
*.md

# Studio runs its own strict checks through the combined gate.
studio/

# Pinned adapter lockfiles: their SHA-256 is pinned in electron/handlers/ai/agentRegistry.ts,
# so a reformat would make every install refuse them.
resources/agents/*.lock.json
