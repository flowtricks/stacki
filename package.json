    "test:welcome": "node test/welcome.js",
    "test:welcomebridge": "node --test test/welcome-bridge.test.js",
    "test:terminalbridge": "node --test test/terminal-bridge.test.js",
    "test:cssvars": "node test/css-vars.js",
    "test:cssvarsrename": "node test/css-vars-rename.js",
    "test:fluid": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/fluid.js",
    "test:varsview": "node test/vars-view.js",
    "test:varsrowheight": "node test/vars-row-height.js",
    "test:variablecore": "node test/variable-core.js",
    "test:varsdrop": "node test/vars-drop.js",
    "test:customvalue": "node test/custom-value.js",
    "test:codeprop": "node test/code-prop.js",
    "test:arrayvalue": "node test/array-value.js",
    "test:listfield": "node test/list-field.js",
    "test:insertbinding": "node test/insert-binding.js",
    "test:frontmattermove": "node test/frontmatter-move.js",
    "test:slotmove": "node test/slot-move.js",
    "test:movingpage": "node test/moving-page.js",
    "test:pageorder": "node test/page-order.js",
    "test:pagetree": "node --test test/page-tree.test.js",
    "test:closeproject": "node test/close-project.js",
    "test:outsideedit": "node test/outside-edit.js",
    "test:hovercost": "node test/hover-cost.js",
    "test:fragmentidentity": "node test/fragment-identity.js",
    "test:unpackedparser": "node test/unpacked-parser.js",
    "test:pressscroll": "node test/press-does-not-scroll.js",
    "test:hoverwithin": "node test/hover-within.js",
    "test:selfwrites": "node test/self-writes.js",
    "test:objectfield": "node test/object-field.js",
    "test:insertsearch": "node test/insert-search.js",
    "test:varconnectopen": "node test/varconnect-open.js",
    "test:insetpresets": "node test/inset-presets.js",
    "test:hideable": "node test/hideable.js",
    "test:transformsettings": "node test/transform-settings.js",
    "test:fieldfocus": "node test/field-focus.js",
    "test:panelsurface": "node test/panel-surface.js",
    "test:computedhold": "node test/computed-hold.js",
    "test:sectiondot": "node test/section-dot.js",
    "test:previewrecovery": "node test/preview-recovery.js",
    "test:morph": "node test/morph.js",
    "test:openedclass": "node test/opened-class.js",
    "test:openedclick": "node test/opened-click.js",
    "test:instanceroot": "node test/instance-root.js",
    "test:chipedit": "node test/chip-edit.js",
    "test:jsguard": "node test/js-guard.js",
    "test:spacingpick": "node test/spacing-pick.js",
    "test:rawattrs": "node test/raw-attrs.js",
    "test:richspan": "node test/rich-span.js",
    "test:variablesboundary": "node test/variables-boundary.js",
    "test:varspanel": "node test/vars-panel.js",
    "test:binding": "node test/binding.js",
    "test:loopsource": "node test/loop-source.js",
    "test:loopcomment": "node test/loop-comment.js",
    "test:attrorder": "node test/attr-order.js",
    "test:assetref": "node test/asset-ref.js",
    "test:clearshows": "node test/clear-shows.js",
    "test:itemfields": "node test/item-fields.js",
    "test:customproperty": "node test/custom-property.js",
    "test:commentmarkers": "node test/comment-markers.js",
    "test:selectorslive": "node test/selectors-live.js",
    "test:selectorwell": "node test/selector-well.js",
    "test:popuplayers": "node test/popup-layers.js",
    "test:scopecompletions": "node test/scope-completions.js",
    "test:querylist": "node test/query-list.js",
    "test:codesearch": "node test/code-search.js",
    "test:componentcreate": "node test/component-create.js",
    "test:componentfolders": "node test/component-folders.js",
    "test:commentregion": "node test/comment-region.js",
    "test:condbranches": "node test/cond-branches.js",
    "test:instanceprops": "node test/instance-props.js",
    "test:variantoptions": "node test/variant-options.js",
    "test:panelsections": "node test/panel-sections.js",
    "test:htmltext": "node test/html-text.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac:unsigned": "npm run build && electron-builder --mac -c.mac.forceCodeSigning=false -c.mac.notarize=false -c.mac.identity=null",
    "test": "npm run build:scripts && node dist/scripts/run-tests.js",
    "test:docdefaults": "node test/doc-defaults.js",
    "test:querycache": "node test/query-cache.js",
    "test:codeeditorlifecycle": "node test/code-editor-lifecycle.js",
    "test:codepanel": "node test/code-panel-model.js",
    "test:buildersigning": "node --test test/builder-signing.test.js",
    "test:vitemodules": "node --experimental-vm-modules --test test/vite-modules.test.ts",
    "performance:report": "npm run build:runtime && node dist/scripts/performance-report.js",
    "integration:dev": "node test/integration/dev-lifecycle.js",
    "build:clean": "node --disable-warning=ExperimentalWarning --experimental-transform-types scripts/clean-build.mts",
    "build:renderer-runtime": "npm run build:morph && npm run build:preload && npm run build:assets",
    "build:morph": "tsc -p electron/tsconfig.morph.json",
    "build:preload": "tsc -p electron/tsconfig.preload.json",
    "build:assets": "node dist/scripts/stage-runtime.js",
    "build:runtime": "npm run build:clean && npm run build:scripts && npm run build:contracts && npm run build:electron",
    "fix:install": "npm run build:scripts && node dist/scripts/fix-node-pty-permissions.js && node dist/scripts/fix-electron-builder-signing.js",
    "fix:pty": "npm run build:scripts && node dist/scripts/fix-node-pty-permissions.js",
    "fix:signing": "npm run build:scripts && node dist/scripts/fix-electron-builder-signing.js",
    "dev:launch": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run dev:window",
    "dev:window": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node dist/scripts/dev-electron.js"
  },
  "dependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@lezer/javascript": "^1.5.4",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "known-css-properties": "^0.37.0",
    "node-pty": "^1.1.0",
    "postcss": "^8.5.25",
    "postcss-selector-parser": "^7.1.4",
    "postcss-value-parser": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "^1.8.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.4.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.stacki.editor",
    "productName": "Stacki",
    "afterPack": "./dist/scripts/afterPack.js",
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/node-pty/**/*"
    ],
    "asarUnpack": [
      "dist/electron/astroParser.js",
      "dist/electron/astroParser.validation.js",
      "dist/electron/componentPreview.js",
      "dist/electron/htmlText.js",
      "dist/electron/frontmatter.js",
      "dist/shared/**",
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "flowtricks",
      "repo": "stacki-releases",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "forceCodeSigning": true,
      "notarize": true
    },
    "win": {
      "icon": "resources/icon.ico",
      "forceCodeSigning": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "exports": {
    ".": "./dist/electron/main.js",
    "./frontmatter": "./dist/electron/frontmatter.js"
  }
}
