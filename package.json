    "test:contentviewrender": "node --test test/content-view-render.test.js",
    "test:entries": "node test/content-entries.js",
    "test:refs": "node test/content-refs.js",
    "test:fields": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/content-fields.js",
    "test:view": "node test/content-view.js",
    "test:panel": "node test/cms-panel.js",
    "test:cmspanelbridge": "node --test test/cms-panel-bridge.test.js",
    "test:previewmessages": "node --test test/preview-messages.test.js",
    "test:assetpanelbridge": "node --test test/asset-panel-bridge.test.js test/asset-panel-lifecycle.test.js",
    "test:palettemodel": "node --test test/palette-model.test.js test/palette-lifecycle.test.js",
    "test:dropdown": "node test/dropdown.js",
