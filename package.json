{
  "name": "stacki",
  "productName": "Stacki",
  "version": "0.1.11",
  "description": "Stacki — a visual builder for Astro projects — pages, layouts, components, props, live preview, and GitHub publishing.",
  "main": "electron/main.js",
  "author": "Timothy Ricks <hello@timothyricks.com>",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "test:markers": "node test/markers.js",
    "test:bridge": "node test/bridge.js",
    "test:outlines": "node test/outlines.js",
    "test:navigator": "node test/navigator.js",
    "test:classattr": "node test/class-attr.js",
    "test:spacing": "node test/spacing.js",
    "test:branchname": "node test/branch-name.js",
    "test:gitbranches": "node test/git-branches.js",
    "test:starter": "node test/starter.js",
    "test:content": "node test/content-config.js",
    "test:entries": "node test/content-entries.js",
    "test:refs": "node test/content-refs.js",
    "test:fields": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/content-fields.js",
    "test:view": "node test/content-view.js",
    "test:panel": "node test/cms-panel.js",
    "test:dropdown": "node test/dropdown.js",
    "test:injectedroutes": "node test/injected-routes.js",
    "test:csscode": "node test/css-code.js",
    "test:computedcolor": "node test/computed-color.js",
    "test:styletarget": "node test/style-target.js",
    "test:thumbs": "electron test/thumbs.js",
    "test:welcome": "node test/welcome.js",
    "test:cssvars": "node test/css-vars.js",
    "test:fluid": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/fluid.js",
    "test:varsview": "node test/vars-view.js",
    "test:varspanel": "node test/vars-panel.js",
    "test:binding": "node test/binding.js",
    "test:loopsource": "node test/loop-source.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac:unsigned": "npm run build && electron-builder --mac -c.mac.forceCodeSigning=false -c.mac.notarize=false -c.mac.identity=null",
    "test": "npm run test:markers && npm run test:bridge && npm run test:outlines && npm run test:navigator && npm run test:classattr && npm run test:spacing && npm run test:branchname && npm run test:gitbranches && npm run test:starter && npm run test:content && npm run test:entries && npm run test:refs && npm run test:fields && npm run test:view && npm run test:panel && npm run test:dropdown && npm run test:injectedroutes && npm run test:csscode && npm run test:computedcolor && npm run test:styletarget && npm run test:thumbs && npm run test:welcome && npm run test:cssvars && npm run test:fluid && npm run test:varsview && npm run test:varspanel && npm run test:binding && npm run test:loopsource"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.7",
    "@uiw/react-codemirror": "^4.25.11",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "known-css-properties": "^0.37.0",
    "postcss": "^8.5.25",
    "postcss-selector-parser": "^7.1.4",
    "postcss-value-parser": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@astrojs/compiler-rs": "^0.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.stacki.editor",
    "productName": "Stacki",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/astroParser.js"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "flowtricks",
      "repo": "stacki-releases",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "forceCodeSigning": true,
      "notarize": true
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
