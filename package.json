{
  "name": "stacki",
  "productName": "Stacki",
  "version": "0.1.61",
  "description": "Stacki — a visual Astro builder with live preview and publishing.",
  "homepage": "https://github.com/flowtricks/stacki",
  "main": "dist/electron/main.js",
  "imports": {
    "#dist/*": "./dist/*"
  },
  "author": "Timothy Ricks <hello@timothyricks.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:policy": "node scripts/policy/scan.mts",
    "check:changed": "node scripts/agent/checkChanged.mts",
    "hooks:install": "node scripts/policy/installGitHooks.mts",
    "roundtrip:report": "npm run build:runtime && node dist/scripts/reports/roundtripReport.js",
    "fixtures:large": "npm run build:runtime && node dist/scripts/reports/largeFixtures.js --write",
    "spike:editor-core": "npm run build:runtime && node test/simulator/spike.bench.ts",
    "release": "npm run build:scripts && node dist/scripts/release/release.js",
    "build:contracts": "tsc -p shared/tsconfig.json",
    "build:electron": "tsc -p electron/tsconfig.json && npm run build:renderer",
    "build:scripts": "tsc -p scripts/tsconfig.build.json",
    "postinstall": "npm run fix:install && npm run build:runtime && npm run hooks:install",
    "dev": "npm run build:runtime && npm run dev:launch",
    "build": "npm run build:runtime && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac:unsigned": "npm run build && node dist/scripts/release/distMacUnsigned.js",
    "test": "npm run build:scripts && node dist/scripts/gate/runTests.js",
    "performance:report": "npm run build:runtime && node dist/scripts/reports/performanceReport.js",
    "integration:dev": "node test/integration/devLifecycle.js",
    "integration:style": "node test/integration/styleLatency.js",
    "bench:render": "npm run build:runtime && node test/integration/renderCost.bench.js",
    "bench:canvas": "npm run build:runtime && node test/integration/canvasCost.bench.js",
    "bench:page-edit": "npm run build:runtime && node test/integration/pageEditCost.bench.js",
    "build:clean": "node scripts/build/cleanBuild.mts",
    "build:renderer": "npm run build:morph && npm run build:preload && npm run build:assets",
    "build:morph": "npm run typecheck:morph && npm run bundle:morph",
    "typecheck:morph": "tsc -p electron/tsconfig.morph.json --noEmit",
    "bundle:morph": "node dist/scripts/build/bundleClients.js morph",
    "build:preload": "npm run typecheck:preload && npm run bundle:preload",
    "typecheck:preload": "tsc -p electron/tsconfig.preload.json --noEmit",
    "bundle:preload": "node dist/scripts/build/bundleClients.js preload",
    "build:assets": "node dist/scripts/build/stageRuntime.js",
    "build:runtime": "npm run build:clean && npm run build:base && npm run build:electron",
    "build:base": "npm run build:scripts && npm run build:contracts",
    "fix:install": "install-electron && npm run fix:pty && npm run fix:signing",
    "fix:pty": "npm run build:scripts && node dist/scripts/install/fixNodePtyPermissions.js",
    "fix:signing": "npm run build:scripts && node dist/scripts/install/fixBuilderSigning.js",
    "dev:launch": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run dev:window",
    "dev:window": "node dist/scripts/build/devElectron.js",
    "studio:install": "npm --prefix studio ci",
    "studio:build": "npm --prefix studio run build",
    "studio:dev": "npm --prefix studio run dev",
    "studio:verify": "npm --prefix studio run verify",
    "studio:release": "npm --prefix studio run release:bundle",
    "create-stacki:build": "node dist/scripts/createStacki/build.js",
    "precreate-stacki:build": "npm run build:scripts && npm run studio:release"
  },
  "dependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@img/sharp-wasm32": "0.35.5",
    "@lezer/highlight": "^1.2.3",
    "@lezer/javascript": "^1.5.4",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "known-css-properties": "^0.37.0",
    "node-pty": "^1.1.0",
    "postcss": "^8.5.25",
    "postcss-selector-parser": "^7.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.5",
    "smol-toml": "^1.8.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.4.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript-eslint/rule-tester": "^8.70.0",
    "@typescript-eslint/utils": "^8.70.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "3.9.9",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.stacki.editor",
    "productName": "Stacki",
    "afterPack": "./dist/scripts/release/afterPack.js",
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/node-pty/**/*",
      "!node_modules/@img/sharp-darwin-*/**",
      "!node_modules/@img/sharp-libvips-darwin-*/**"
    ],
    "asarUnpack": [
      "dist/electron/parse/**",
      "dist/electron/previewServer/**",
      "dist/shared/**",
      "**/node_modules/node-pty/**",
      "**/node_modules/@img/sharp-wasm32/**"
    ],
    "npmRebuild": false,
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "flowtricks",
      "repo": "stacki-releases",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "forceCodeSigning": true,
      "notarize": true,
      "minimumSystemVersion": "13.0.0",
      "x64ArchFiles": "**/node-pty/prebuilds/darwin-{x64,arm64}/{pty.node,spawn-helper}"
    },
    "win": {
      "icon": "resources/icon.ico",
      "forceCodeSigning": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "resources/icon.png",
      "executableName": "stacki",
      "executableArgs": [
        "--enable-sandbox"
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "afterInstall": "dist/resources/linuxAfterInstall.tpl"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "exports": {
    ".": "./dist/electron/main.js"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  }
}
