{
  "name": "stacki",
  "productName": "Stacki",
  "version": "0.1.21",
  "description": "Stacki — a visual builder for Astro projects — pages, layouts, components, props, live preview, and GitHub publishing.",
  "main": "electron/main.js",
  "author": "Timothy Ricks <hello@timothyricks.com>",
  "license": "MIT",
  "scripts": {
    "roundtrip:report": "node scripts/roundtrip-report.js",
    "test:roundtrip": "node --test 'test/*.test.js'",
    "postinstall": "node scripts/fix-node-pty-permissions.js",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/dev-electron.mjs\"",
    "build": "vite build",
    "test:markers": "node test/markers.js && node test/slot-markers.js && node test/slot-api.js && node test/insert-target.js",
    "test:bridge": "node test/bridge.js",
    "test:outlines": "node test/outlines.js",
    "test:navigator": "node test/navigator.js",
    "test:classattr": "node test/class-attr.js",
    "test:gridtracks": "node test/grid-tracks.js",
    "test:windowbounds": "node test/window-bounds.js",
    "test:transformunits": "node test/transform-units.js",
    "test:popoverdismiss": "node test/popover-dismiss.js",
    "test:nodestates": "node test/node-states.js",
    "test:spacing": "node test/spacing.js",
    "test:gapbands": "node test/gap-bands.js",
    "test:gaphover": "node test/gap-hover.js",
    "test:popoverdropdown": "node test/popover-dropdown.js",
    "test:panelfield": "node test/panel-field.js",
    "test:branchname": "node test/branch-name.js",
    "test:sound": "node test/sound.js",
    "test:panelsound": "node test/panel-sound.js",
    "test:segmented": "node test/segmented.js",
    "test:coloralpha": "node test/color-alpha.js",
    "test:colorlive": "node test/color-live.js",
    "test:enterstays": "node test/enter-stays.js",
    "test:popupscroll": "node test/popup-scroll.js",
    "test:focus": "node test/focus.js",
    "test:tokenfield": "node test/token-field.js",
    "test:canvasclick": "node test/canvas-click.js",
    "test:gitbranches": "node test/git-branches.js",
    "test:conflicts": "node test/conflicts.js",
    "test:githistory": "node test/git-history.js",
    "test:historypanel": "node test/history-panel.js",
    "test:undoreach": "node test/undo-reach.js",
    "test:filebrowser": "node test/file-browser.js",
    "test:assetdelete": "node test/asset-delete.js",
    "test:gradient": "node test/gradient.js",
    "test:gitsnapshot": "node test/git-snapshot.js",
    "test:previewworktree": "node test/preview-worktree.js",
    "test:apprenders": "node test/app-renders.js",
    "test:starter": "node test/starter.js",
    "test:content": "node test/content-config.js",
    "test:entries": "node test/content-entries.js",
    "test:refs": "node test/content-refs.js",
    "test:fields": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/content-fields.js",
    "test:view": "node test/content-view.js",
    "test:panel": "node test/cms-panel.js",
    "test:dropdown": "node test/dropdown.js",
    "test:injectedroutes": "node test/injected-routes.js",
    "test:csscode": "node test/css-code.js",
    "test:computedcolor": "node test/computed-color.js",
    "test:styletarget": "node test/style-target.js",
    "test:thumbs": "electron test/thumbs.js",
    "test:welcome": "node test/welcome.js",
    "test:cssvars": "node test/css-vars.js",
    "test:cssvarsrename": "node test/css-vars-rename.js",
    "test:fluid": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/fluid.js",
    "test:varsview": "node test/vars-view.js",
    "test:varsrowheight": "node test/vars-row-height.js",
    "test:varsdrop": "node test/vars-drop.js",
    "test:customvalue": "node test/custom-value.js",
    "test:codeprop": "node test/code-prop.js",
    "test:arrayvalue": "node test/array-value.js",
    "test:listfield": "node test/list-field.js",
    "test:insertbinding": "node test/insert-binding.js",
    "test:frontmattermove": "node test/frontmatter-move.js",
    "test:slotmove": "node test/slot-move.js",
    "test:movingpage": "node test/moving-page.js",
    "test:pageorder": "node test/page-order.js",
    "test:closeproject": "node test/close-project.js",
    "test:outsideedit": "node test/outside-edit.js",
    "test:hovercost": "node test/hover-cost.js",
    "test:fragmentidentity": "node test/fragment-identity.js",
    "test:unpackedparser": "node test/unpacked-parser.js",
    "test:insertsearch": "node test/insert-search.js",
    "test:varconnectopen": "node test/varconnect-open.js",
    "test:insetpresets": "node test/inset-presets.js",
    "test:hideable": "node test/hideable.js",
    "test:transformsettings": "node test/transform-settings.js",
    "test:fieldfocus": "node test/field-focus.js",
    "test:panelsurface": "node test/panel-surface.js",
    "test:computedhold": "node test/computed-hold.js",
    "test:sectiondot": "node test/section-dot.js",
    "test:previewrecovery": "node test/preview-recovery.js",
    "test:morph": "node test/morph.js",
    "test:openedclass": "node test/opened-class.js",
    "test:openedclick": "node test/opened-click.js",
    "test:instanceroot": "node test/instance-root.js",
    "test:chipedit": "node test/chip-edit.js",
    "test:jsguard": "node test/js-guard.js",
    "test:spacingpick": "node test/spacing-pick.js",
    "test:rawattrs": "node test/raw-attrs.js",
    "test:richspan": "node test/rich-span.js",
    "test:varspanel": "node test/vars-panel.js",
    "test:binding": "node test/binding.js",
    "test:loopsource": "node test/loop-source.js",
    "test:selectorslive": "node test/selectors-live.js",
    "test:selectorwell": "node test/selector-well.js",
    "test:popuplayers": "node test/popup-layers.js",
    "test:scopecompletions": "node test/scope-completions.js",
    "test:querylist": "node test/query-list.js",
    "test:codesearch": "node test/code-search.js",
    "test:componentcreate": "node test/component-create.js",
    "test:componentfolders": "node test/component-folders.js",
    "test:commentregion": "node test/comment-region.js",
    "test:condbranches": "node test/cond-branches.js",
    "test:instanceprops": "node test/instance-props.js",
    "test:variantoptions": "node test/variant-options.js",
    "test:panelsections": "node test/panel-sections.js",
    "test:htmltext": "node test/html-text.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac:unsigned": "npm run build && electron-builder --mac -c.mac.forceCodeSigning=false -c.mac.notarize=false -c.mac.identity=null",
    "test": "npm run test:markers && npm run test:apprenders && npm run test:bridge && npm run test:outlines && npm run test:navigator && npm run test:classattr && npm run test:gridtracks && npm run test:windowbounds && npm run test:transformunits && npm run test:popoverdismiss && npm run test:nodestates && npm run test:spacing && npm run test:gapbands && npm run test:gaphover && npm run test:popoverdropdown && npm run test:panelfield && npm run test:branchname && npm run test:sound && npm run test:panelsound && npm run test:segmented && npm run test:coloralpha && npm run test:colorlive && npm run test:enterstays && npm run test:popupscroll && npm run test:focus && npm run test:tokenfield && npm run test:canvasclick && npm run test:gitbranches && npm run test:conflicts && npm run test:githistory && npm run test:historypanel && npm run test:undoreach && npm run test:filebrowser && npm run test:assetdelete && npm run test:gradient && npm run test:gitsnapshot && npm run test:previewworktree && npm run test:starter && npm run test:content && npm run test:entries && npm run test:refs && npm run test:fields && npm run test:view && npm run test:panel && npm run test:dropdown && npm run test:injectedroutes && npm run test:csscode && npm run test:computedcolor && npm run test:styletarget && npm run test:thumbs && npm run test:welcome && npm run test:cssvars && npm run test:cssvarsrename && npm run test:fluid && npm run test:varsview && npm run test:varsrowheight && npm run test:varsdrop && npm run test:customvalue && npm run test:codeprop && npm run test:arrayvalue && npm run test:listfield && npm run test:insertbinding && npm run test:frontmattermove && npm run test:slotmove && npm run test:movingpage && npm run test:pageorder && npm run test:closeproject && npm run test:outsideedit && npm run test:hovercost && npm run test:fragmentidentity && npm run test:unpackedparser && npm run test:insertsearch && npm run test:varconnectopen && npm run test:insetpresets && npm run test:hideable && npm run test:transformsettings && npm run test:fieldfocus && npm run test:panelsurface && npm run test:computedhold && npm run test:sectiondot && npm run test:previewrecovery && npm run test:morph && npm run test:openedclass && npm run test:openedclick && npm run test:instanceroot && npm run test:chipedit && npm run test:jsguard && npm run test:spacingpick && npm run test:rawattrs && npm run test:richspan && npm run test:varspanel && npm run test:binding && npm run test:loopsource && npm run test:selectorslive && npm run test:selectorwell && npm run test:popuplayers && npm run test:scopecompletions && npm run test:querylist && npm run test:codesearch && npm run test:componentcreate && npm run test:componentfolders && npm run test:commentregion && npm run test:condbranches && npm run test:instanceprops && npm run test:variantoptions && npm run test:panelsections && npm run test:htmltext && npm run test:roundtrip"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.7",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "known-css-properties": "^0.37.0",
    "node-pty": "^1.1.0",
    "postcss": "^8.5.25",
    "postcss-selector-parser": "^7.1.4",
    "postcss-value-parser": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@astrojs/compiler-rs": "^0.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.stacki.editor",
    "productName": "Stacki",
    "afterPack": "./scripts/afterPack.js",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "scripts/fix-node-pty-permissions.js",
      "package.json",
      "node_modules/node-pty/**/*"
    ],
    "asarUnpack": [
      "electron/astroParser.js",
      "electron/htmlText.js",
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "flowtricks",
      "repo": "stacki-releases",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "forceCodeSigning": true,
      "notarize": true
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
