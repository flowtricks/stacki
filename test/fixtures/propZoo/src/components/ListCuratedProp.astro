---
import { getCollection } from 'astro:content';
import { queryItems } from '../lib/queryItems.mjs';
const { items: propItems = { "itemIds": [] } } = Astro.props;
const posts = queryItems((await getCollection("blog")) || [], ({ "curated": propItems }), {});
---
<ul class="list-curated-prop">{posts.map((post) => <li>{post.data.title}</li>)}</ul>
